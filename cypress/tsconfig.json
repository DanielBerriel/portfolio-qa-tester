{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.cypress.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["cypress", "cypress-axe", "node"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["**/*.ts"]
}
